// scripts/figures.py fills the marked rows from the tool's output and draws this figure
digraph walks {
  bgcolor="white"
  fontname="Helvetica"
  newrank=true
  compound=true
  nodesep=0.4
  ranksep=0.55
  node [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded", fillcolor="#e8eef7", color="#4a6fa5", margin="0.15,0.06"]
  edge [fontname="Helvetica", fontsize=11, color="#555555", arrowsize=0.8]

  subgraph {
    graph [labeljust=l, fontsize=14, color="#bbbbbb", style="rounded,filled", fillcolor="#fafafa", margin=14]

    subgraph cluster_graph {
      label=<<B>1. A base-level graph (GFA)</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#555555">W lines give each haplotype's path</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#555555">HG002#1 takes node 5 in place of 3 (orange); CHM13 skips 3 (purple)</FONT><BR ALIGN="LEFT"/>>
      // begin graph
      n1 [label=<<B>1</B><BR/><FONT POINT-SIZE="10">10 bp</FONT>>]
      n2 [label=<<B>2</B><BR/><FONT POINT-SIZE="10">10 bp</FONT>>]
      n3 [label=<<B>3</B><BR/><FONT POINT-SIZE="10">10 bp</FONT>>]
      n4 [label=<<B>4</B><BR/><FONT POINT-SIZE="10">10 bp</FONT>>]
      n5 [label=<<B>5</B><BR/><FONT POINT-SIZE="10">15 bp</FONT>>, fillcolor="#fde6cf", color="#c77a2b"]
      {rank=same; n1; n2; n3; n4}
      n1 -> n2 [weight=20]
      n2 -> n3 [weight=20]
      n3 -> n4 [weight=20]
      n2 -> n5 [color="#c77a2b", constraint=false]
      n5 -> n4 [color="#c77a2b", constraint=false]
      n2:s -> n4:s [color="#8a5fb0", constraint=false]
      n5 -> n3 [style=invis, weight=20]
      nbelow [style=invis, label="", width=0, height=0]
      n3 -> nbelow [style=invis]
      // end graph
    }

    subgraph cluster_file {
      label=<<B>2. graph.GRCh38.walks.bed.gz</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#555555">per chunk: R, the reference path, once; each distinct route off R once; the routes each haplotype takes</FONT><BR ALIGN="LEFT"/>>
      rows [shape=plaintext, style="", label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#aaaaaa">
          <!-- begin rows -->
          <TR><TD BGCOLOR="#e8eef7">R</TD><TD ALIGN="LEFT">1 2 3 4</TD></TR>
          <TR><TD BGCOLOR="#ede4f5">route 0</TD><TD ALIGN="LEFT">2 → 4</TD></TR>
          <TR><TD BGCOLOR="#fde6cf">route 1</TD><TD ALIGN="LEFT">2 → 5 → 4</TD></TR>
          <TR><TD>CHM13#0</TD><TD ALIGN="LEFT">route 0</TD></TR>
          <TR><TD>HG002#1</TD><TD ALIGN="LEFT">route 1</TD></TR>
          <TR><TD>HG002#2</TD><TD ALIGN="LEFT">no route</TD></TR>
          <!-- end rows -->
        </TABLE>>]
    }

    subgraph cluster_rebuilt {
      label=<<B>3. What the reader rebuilds</B><BR ALIGN="LEFT"/><FONT POINT-SIZE="12" COLOR="#555555">R with each haplotype's routes spliced in</FONT><BR ALIGN="LEFT"/>>
      rebuilt [shape=plaintext, style="", label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="4" COLOR="#ffffff">
          <!-- begin rebuilt -->
          <TR><TD BORDER="0" ALIGN="RIGHT">GRCh38#0</TD><TD WIDTH="60" BGCOLOR="#e8eef7">1</TD><TD WIDTH="60" BGCOLOR="#e8eef7">2</TD><TD WIDTH="60" BGCOLOR="#e8eef7">3</TD><TD WIDTH="60" BGCOLOR="#e8eef7">4</TD><TD BORDER="0" ALIGN="LEFT"></TD></TR>
          <TR><TD BORDER="0" ALIGN="RIGHT">CHM13#0</TD><TD BGCOLOR="#e8eef7">1</TD><TD BGCOLOR="#e8eef7">2</TD><TD BORDER="0"></TD><TD BGCOLOR="#e8eef7">4</TD><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#8a5fb0">route 0</FONT></TD></TR>
          <TR><TD BORDER="0" ALIGN="RIGHT">HG002#1</TD><TD BGCOLOR="#e8eef7">1</TD><TD BGCOLOR="#e8eef7">2</TD><TD BGCOLOR="#fde6cf">5</TD><TD BGCOLOR="#e8eef7">4</TD><TD BORDER="0" ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#c77a2b">route 1</FONT></TD></TR>
          <TR><TD BORDER="0" ALIGN="RIGHT">HG002#2</TD><TD BGCOLOR="#e8eef7">1</TD><TD BGCOLOR="#e8eef7">2</TD><TD BGCOLOR="#e8eef7">3</TD><TD BGCOLOR="#e8eef7">4</TD><TD BORDER="0" ALIGN="LEFT"></TD></TR>
          <!-- end rebuilt -->
        </TABLE>>]
    }
  }

  // begin arrows
  nbelow -> rows [ltail=cluster_graph, lhead=cluster_file, label="  gfa-to-tabix --walks\n  --refs GRCh38", penwidth=2]
  rows -> rebuilt [ltail=cluster_file, lhead=cluster_rebuilt, label="  a region query\n  returns the chunk", penwidth=2]
  // end arrows
}
