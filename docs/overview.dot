// Draw with: dot -Tsvg docs/overview.dot -o docs/overview.svg
digraph overview {
  bgcolor="white"
  fontname="Helvetica"
  rankdir=TB
  newrank=true
  compound=true
  nodesep=0.45
  ranksep=0.7
  node [fontname="Helvetica", fontsize=12, shape=box, style="filled,rounded", fillcolor="#e8eef7", color="#4a6fa5", margin="0.15,0.08"]
  edge [fontname="Helvetica", fontsize=11, color="#555555"]

  subgraph cluster_graph {
    label=<<B>1. The graph (GFA)</B>   reference chr1 in blue, an alternate allele in orange>
    labeljust=l
    fontname="Helvetica"
    fontsize=14
    color="#bbbbbb"
    style="rounded,filled"
    fillcolor="#fafafa"
    margin=16
    s1 [label="s1\nchr1:0-10"]
    s2 [label="s2\nchr1:10-20"]
    s3 [label="s3\nchr1:20-30"]
    s4 [label="s4\nchr1:30-40"]
    s5 [label="s5\noff chr1, rank 1", fillcolor="#fde6cf", color="#c77a2b"]
    {rank=same; s1; s2; s3; s4}
    s1 -> s2 -> s3 -> s4 [weight=20]
    s2 -> s5 [color="#c77a2b"]
    s5 -> s4 [color="#c77a2b", constraint=false]
  }

  subgraph cluster_files {
    label=<<B>2. The index (hprc.segs.bed.gz)</B>   one row per node, filed under a reference interval>
    labeljust=l
    fontname="Helvetica"
    fontsize=14
    color="#bbbbbb"
    style="rounded,filled"
    fillcolor="#fafafa"
    margin=16
    rows [shape=plaintext, style="", label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#999999">
        <TR BGCOLOR="#dddddd"><TD>anchor</TD><TD>start</TD><TD>end</TD><TD>node</TD><TD>rank</TD></TR>
        <TR BGCOLOR="#e8eef7"><TD>chr1</TD><TD>0</TD><TD>10</TD><TD>s1</TD><TD>0</TD></TR>
        <TR BGCOLOR="#e8eef7"><TD>chr1</TD><TD>10</TD><TD>20</TD><TD>s2</TD><TD>0</TD></TR>
        <TR BGCOLOR="#fde6cf"><TD>chr1</TD><TD><B>10</B></TD><TD><B>40</B></TD><TD>s5</TD><TD>1</TD></TR>
        <TR BGCOLOR="#e8eef7"><TD>chr1</TD><TD>20</TD><TD>30</TD><TD>s3</TD><TD>0</TD></TR>
        <TR BGCOLOR="#e8eef7"><TD>chr1</TD><TD>30</TD><TD>40</TD><TD>s4</TD><TD>0</TD></TR>
      </TABLE>>]
    note [shape=plaintext, style="", fontsize=12, fontcolor="#a15f1c", label="A reference node keeps its own span.\nAn alternate allele lies off chr1, so its row\ntakes the span of the reference nodes it\nlinks to: 10-40, from s2 to s4."]
    {rank=same; rows; note}
    rows -> note [style=invis]
  }

  subgraph cluster_query {
    label=<<B>3. A region query</B>   one tabix range request returns the rows that overlap>
    labeljust=l
    fontname="Helvetica"
    fontsize=14
    color="#bbbbbb"
    style="rounded,filled"
    fillcolor="#fafafa"
    margin=16
    q [label="chr1:22-28", fillcolor="#eeeeee", color="#888888"]
    r3 [label="s3  (reference, 20-30)"]
    r5 [label="s5  (alternate, 10-40)", fillcolor="#fde6cf", color="#c77a2b"]
    {rank=same; r3; r5}
    q -> r3
    q -> r5
  }

  s5 -> rows [ltail=cluster_graph, lhead=cluster_files, label="  gfa-to-tabix files\n  each node by coordinate", penwidth=2]
  rows -> q [ltail=cluster_files, lhead=cluster_query, label="  a browser asks\n  for a region", penwidth=2]
}
